# Frontend (Next.js) environment — set these on the Railway "frontend" service.

# Canonical site URL (used for metadata, canonicals, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://venkatapagadala.com

# Backend API base. Server-side code reads BACKEND_URL; client code reads
# NEXT_PUBLIC_BACKEND_URL. Point both at the Railway backend service's public
# URL (the app calls `${BACKEND_URL}/api/...`).
BACKEND_URL=https://monomind-backend.up.railway.app
NEXT_PUBLIC_BACKEND_URL=https://monomind-backend.up.railway.app

# Required so Nixpacks' `npm install` tolerates the eslint peer-dep conflict
# (eslint 9 vs eslint-config-next 14). Set as a Railway service variable.
NPM_CONFIG_LEGACY_PEER_DEPS=true
