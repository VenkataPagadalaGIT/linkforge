# Backend (FastAPI) environment — set these on the Railway "backend" service.
# Copy to .env for local dev; on Railway set them in the service Variables tab.

# --- MongoDB (Railway Mongo service) ---
# From the Railway Mongo service → Connect → "Mongo Connection URL".
# Prefer the private networking URL (mongodb://...railway.internal:27017) for
# service-to-service; use the public proxy URL only for one-off external access.
MONGO_URL=mongodb://mongo:PASSWORD@mongodb.railway.internal:27017
DB_NAME=monomind

# --- Auth ---
# Generate once:  openssl rand -hex 32
JWT_SECRET=__CHANGE_ME__
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=__CHANGE_ME_STRONG__

# --- Email (Resend) — optional; contact form no-ops gracefully if unset ---
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
CONTACT_NOTIFICATION_EMAIL=vdepagadala@gmail.com

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=https://venkatapagadala.com,https://www.venkatapagadala.com
