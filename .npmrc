# Pin install behaviour so it is identical on every npm version.
# eslint-config-next@14 declares a peer range of eslint ^7||^8 while this repo
# runs eslint 9. npm 10 (Railway today) tolerates that; npm 11 hard-fails the
# install. eslint is not used at build time (next.config sets
# eslint.ignoreDuringBuilds), so relaxing peer resolution is safe and keeps the
# build reproducible if the builder image bumps npm.
legacy-peer-deps=true
